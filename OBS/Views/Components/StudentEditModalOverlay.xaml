<UserControl x:Class="OBS.Views.Components.StudentEditModalOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:OBS.Converters"
             xmlns:local="clr-namespace:OBS.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:PathToImageConverter x:Key="PathToImage"/>

        <Style x:Key="EditFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Margin" Value="4,2,0,0"/>
        </Style>

        <Style x:Key="EditTextBox" TargetType="ui:TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="{DynamicResource BgBodyBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#80000000"
          Panel.ZIndex="250"
          Visibility="{Binding IsStudentEditModalVisible, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStudentEditModalVisible, Source={x:Static local:GlobalState.Instance}}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="40" To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="30" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:0.2">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- Modal Kart -->
        <Border Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Margin="24,40"
                VerticalAlignment="Center"
                MaxHeight="580">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" Direction="270" ShadowDepth="8"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="20">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" Visibility="Collapsed"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel>
                    <!-- Başlık -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Öğrenci Düzenle" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="30" Height="30" Cursor="Hand"
                                Command="{Binding CloseStudentEditModalCommand, Source={x:Static local:GlobalState.Instance}}"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="15">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Fotoğraf -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                                Background="{DynamicResource BgBodyBrush}" ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                            <Image Source="{Binding EditPhotoPath, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource PathToImage}}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Fotoğraf" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <ui:Button Content="Değiştir" Appearance="Primary" Padding="10,5" FontSize="11"
                                       HorizontalAlignment="Left"
                                       Click="OnChangePhotoClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ad -->
                    <TextBlock Text="Ad" Style="{StaticResource EditFieldLabel}"/>
                    <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8">
                        <ui:TextBox Text="{Binding EditFirstName, Source={x:Static local:GlobalState.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditTextBox}" Margin="0"/>
                    </Border>
                    <TextBlock Text="{Binding EditFirstNameError, Source={x:Static local:GlobalState.Instance}}" Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding HasEditFirstNameError, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Soyad -->
                    <TextBlock Text="Soyad" Style="{StaticResource EditFieldLabel}" Margin="0,8,0,4"/>
                    <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8">
                        <ui:TextBox Text="{Binding EditLastName, Source={x:Static local:GlobalState.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditTextBox}" Margin="0"/>
                    </Border>
                    <TextBlock Text="{Binding EditLastNameError, Source={x:Static local:GlobalState.Instance}}" Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding HasEditLastNameError, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Sınıf -->
                    <TextBlock Text="Sınıf" Style="{StaticResource EditFieldLabel}" Margin="0,8,0,4"/>
                    <ComboBox ItemsSource="{Binding EditClassList, Source={x:Static local:GlobalState.Instance}}"
                              SelectedItem="{Binding EditClassName, Source={x:Static local:GlobalState.Instance}, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False"
                              Padding="10,7"
                              Margin="0,0,0,2"
                              Background="{DynamicResource BgBodyBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding EditClassError, Source={x:Static local:GlobalState.Instance}}" Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding HasEditClassError, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Numara -->
                    <TextBlock Text="Numara" Style="{StaticResource EditFieldLabel}" Margin="0,8,0,4"/>
                    <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8">
                        <ui:TextBox Text="{Binding EditStudentNumber, Source={x:Static local:GlobalState.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditTextBox}" Margin="0"/>
                    </Border>
                    <TextBlock Text="{Binding EditStudentNumberError, Source={x:Static local:GlobalState.Instance}}" Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding HasEditStudentNumberError, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- TC -->
                    <TextBlock Text="TC Kimlik No" Style="{StaticResource EditFieldLabel}" Margin="0,8,0,4"/>
                    <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8">
                        <ui:TextBox Text="{Binding EditTcNo, Source={x:Static local:GlobalState.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource EditTextBox}" Margin="0" MaxLength="11"/>
                    </Border>
                    <TextBlock Text="{Binding EditTcNoError, Source={x:Static local:GlobalState.Instance}}" Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding HasEditTcNoError, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Doğum Tarihi -->
                    <TextBlock Text="Doğum Tarihi" Style="{StaticResource EditFieldLabel}" Margin="0,8,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding EditBirthDateString, Source={x:Static local:GlobalState.Instance}, Mode=OneWay}"
                                    IsReadOnly="True"
                                    Padding="10,7"
                                    Margin="0,0,4,0"
                                    Cursor="Hand"
                                    MouseDown="OnBirthDateClick"/>
                        <Button Grid.Column="1" Width="36" Height="36" Cursor="Hand"
                                Click="OnCalendarButtonClick"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource BgBodyBrush}" CornerRadius="8">
                                        <ui:SymbolIcon Symbol="Calendar24" FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Popup x:Name="BirthDatePickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Mouse">
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.2" Direction="270" ShadowDepth="4"/>
                            </Border.Effect>
                            <Calendar x:Name="EditCalendar"
                                      SelectedDate="{Binding EditBirthDate, Source={x:Static local:GlobalState.Instance}}"
                                      DisplayDateStart="1950-01-01"
                                      DisplayDateEnd="2030-12-31"
                                      SelectedDatesChanged="OnCalendarSelected"/>
                        </Border>
                    </Popup>

                    <!-- Butonlar -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1" Content="İptal" Appearance="Secondary"
                                   Padding="18,9" FontSize="12" Margin="0,0,8,0"
                                   Command="{Binding CloseStudentEditModalCommand, Source={x:Static local:GlobalState.Instance}}"/>
                        <ui:Button Grid.Column="2" Content="Kaydet" Appearance="Primary"
                                   Padding="18,9" FontSize="12"
                                   Background="{DynamicResource AccentBrush}"
                                   Command="{Binding SaveStudentEditCommand, Source={x:Static local:GlobalState.Instance}}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
