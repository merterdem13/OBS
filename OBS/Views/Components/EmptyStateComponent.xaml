<UserControl x:Class="OBS.Views.Components.EmptyStateComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Genel Boş Mesaj -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Students.Count}" Value="0"/>
                                <Condition Binding="{Binding IsFavoriteMode}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <TextBlock Text="Öğrenci aratınız veya Sınıf seçiniz."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,48"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,72">
                <TextBlock Text="{Binding TotalStudentCount, StringFormat=Toplam Öğrenci: {0}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="  •  "
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalClassCount, StringFormat=Toplam Sınıf: {0}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Favoriler Boş Mesaj -->
        <TextBlock Text="Favori Listeniz Boş!"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Students.Count}" Value="0"/>
                                <Condition Binding="{Binding IsFavoriteMode}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
