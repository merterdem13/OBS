<UserControl x:Class="OBS.Views.Components.FloatingActionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OBS.Converters"
             xmlns:local="clr-namespace:OBS.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="12,0,12,12"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Visibility="{Binding IsUpdateDownloading, Source={x:Static local:GlobalState.Instance}, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="24" To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.15" Direction="270" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Güncelleme indiriliyor..."
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding UpdateDownloadProgress, Source={x:Static local:GlobalState.Instance}, StringFormat='%{0}'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                </Grid>

                <ProgressBar Value="{Binding UpdateDownloadProgress, Source={x:Static local:GlobalState.Instance}}"
                             Maximum="100"
                             Height="5"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource BorderColorBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
