<UserControl x:Class="OBS.Views.Components.CreateTeamComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:OBS.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StringMatchToBooleanConverter x:Key="StringMatchToBoolean"/>
    </UserControl.Resources>

    <Grid Background="Transparent"
          DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Bar (Geri + Başlık) -->
            <RowDefinition Height="Auto"/> <!-- Takım Adı -->
            <RowDefinition Height="Auto"/> <!-- Cinsiyet -->
            <RowDefinition Height="Auto"/> <!-- Kategori -->
            <RowDefinition Height="Auto"/> <!-- Öğrenci Arama -->
            <RowDefinition Height="Auto"/> <!-- Arama Sonuçları -->
            <RowDefinition Height="Auto"/> <!-- Mevcut Üyeler Başlığı -->
            <RowDefinition Height="*"/>    <!-- Mevcut Üyeler Listesi -->
            <RowDefinition Height="Auto"/> <!-- Hata / Uyarı Mesajı -->
        </Grid.RowDefinitions>

        <!-- Üst Bar: Geri Butonu + Başlık -->
        <Grid Grid.Row="0" Margin="12,8,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/> <!-- İptal / Geri -->
            </Grid.ColumnDefinitions>

            <!-- Geri Butonu -->
             <ui:Button Grid.Column="0"
                        Appearance="Secondary"
                        Padding="8,6"
                        ToolTip="Oluşturmayı İptal Et"
                        Command="{Binding CancelCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24"/>
                </ui:Button.Icon>
            </ui:Button>

            <!-- Başlık -->
            <TextBlock Grid.Column="1"
                       Text="Yeni Takım Oluştur"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <!-- Sağ Tarafı Dengelemek İçin Boşluk -->
            <ContentControl Grid.Column="2" Width="36"/>
        </Grid>

        <!-- Takım Adı -->
        <StackPanel Grid.Row="1" Margin="12,12,12,14">
            <TextBlock Text="Takım Adı"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TeamNameBox"
                             Grid.Column="0"
                             PlaceholderText="Takım adını giriniz..."
                             Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"/>
                
                <ui:Button Grid.Column="2"
                           Content="Oluştur"
                           Appearance="Primary"
                           Background="{DynamicResource SpecialButtonBgBrush}"
                           Foreground="{DynamicResource SpecialButtonTextBrush}"
                           Padding="10,6"
                           Command="{Binding CreateCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Checkmark24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </StackPanel>

        <!-- Cinsiyet Seçimi -->
        <StackPanel Grid.Row="2" Margin="12,0,12,14">
            <TextBlock Text="Cinsiyet"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                 <RadioButton x:Name="RadioErkek"
                              Grid.Column="0"
                              Content="Erkek"
                              GroupName="Gender"
                              IsChecked="{Binding SelectedGenderMode, Converter={StaticResource StringMatchToBoolean}, ConverterParameter=Erkek, Mode=TwoWay}"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Padding="8,6"/>
                 <RadioButton x:Name="RadioKiz"
                              Grid.Column="2"
                              Content="Kız"
                              GroupName="Gender"
                              IsChecked="{Binding SelectedGenderMode, Converter={StaticResource StringMatchToBoolean}, ConverterParameter=Kız, Mode=TwoWay}"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Padding="8,6"/>
                 <RadioButton x:Name="RadioBelirtilmemis"
                              Grid.Column="4"
                              Content="Karma"
                              GroupName="Gender"
                              IsChecked="{Binding SelectedGenderMode, Converter={StaticResource StringMatchToBoolean}, ConverterParameter=Karma, Mode=TwoWay}"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Padding="8,6"/>
            </Grid>
        </StackPanel>

        <!-- Kategori Seçimi -->
        <StackPanel Grid.Row="3" Margin="12,0,12,14">
            <TextBlock Text="Kategori"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="CategoryCombo"
                      Height="34"
                      VerticalContentAlignment="Center"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedCategory, Mode=TwoWay}">
                <ComboBoxItem Content="Belirtilmemiş" Tag="Belirtilmemiş"/>
                <ComboBoxItem Content="Futbol" Tag="Futbol"/>
                <ComboBoxItem Content="Futsal" Tag="Futsal"/>
                <ComboBoxItem Content="Basketbol" Tag="Basketbol"/>
                <ComboBoxItem Content="Hentbol" Tag="Hentbol"/>
                <ComboBoxItem Content="Voleybol" Tag="Voleybol"/>
            </ComboBox>
        </StackPanel>

        <!-- Öğrenci Arama -->
        <StackPanel Grid.Row="4" Margin="12,0,12,8">
            <TextBlock Text="Öğrenci Ekle (İsteğe Bağlı)"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             PlaceholderText="Öğrenci Ara (Ad, No)..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <!-- Favoriler Butonu -->
                 <Button Grid.Column="2"
                         Width="32" Height="32"
                         BorderThickness="0"
                         Background="Transparent"
                         Cursor="Hand"
                         ToolTip="Favorilerden Ekle"
                         Command="{Binding ToggleFavoritesCommand}"
                         RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon FontSize="20"
                                   Symbol="Star24"
                                   Filled="{Binding IsFavoritesMode}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavoritesMode}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                 </Button>
            </Grid>
        </StackPanel>

        <!-- Arama Sonuçları -->
        <Border Grid.Row="5"
                x:Name="SearchResultsBorder"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MaxHeight="160"
                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}"
                Margin="12,0,12,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.1" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
             <ListBox x:Name="SearchResultsList"
                      ItemsSource="{Binding SearchResults}"
                      Background="Transparent"
                      BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnSearchResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    ClipToBounds="True"
                                    Background="{DynamicResource BgBodyBrush}"
                                    Margin="0,0,8,0">
                                <Image Source="{Binding PhotoPath, Converter={StaticResource PathToImage}}"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}No: {0}  •  {1}">
                                            <Binding Path="StudentNumber"/>
                                            <Binding Path="Class"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                             <ui:Button Grid.Column="2"
                                        Appearance="Primary"
                                        Background="{DynamicResource SpecialButtonBgBrush}"
                                        Foreground="{DynamicResource SpecialButtonTextBrush}"
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        ToolTip="Listeye Ekle"
                                        Command="{Binding DataContext.AddStudentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                 <ui:SymbolIcon Symbol="Add24" FontSize="14"/>
                             </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Mevcut Üyeler Başlığı -->
         <TextBlock Grid.Row="6"
                    x:Name="MembersHeader"
                    Text="{Binding MembersHeaderText}"
                    FontSize="12" FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="12,0,12,6"/>

        <!-- Mevcut Üyeler Listesi (Henüz oluşturulmadı) -->
         <ListBox Grid.Row="7"
                  x:Name="MembersList"
                  ItemsSource="{Binding PendingMembers}"
                  Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 Padding="12,0,12,0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    ClipToBounds="True"
                                    Background="{DynamicResource BgBodyBrush}"
                                    Margin="0,0,10,0">
                                <Image Source="{Binding PhotoPath, Converter={StaticResource PathToImage}}"
                                       Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}No: {0}  •  {1}">
                                            <Binding Path="StudentNumber"/>
                                            <Binding Path="Class"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                             <ui:Button Grid.Column="2"
                                        Appearance="Secondary"
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        ToolTip="Listeden Çıkar"
                                        Command="{Binding DataContext.RemovePendingMemberCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                 <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                             </ui:Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Hata Mesajı -->
        <TextBlock Grid.Row="8"
                   x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource BtnRedBrush}"
                   FontSize="12"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                   Margin="12,0,12,8"/>

    </Grid>
</UserControl>
