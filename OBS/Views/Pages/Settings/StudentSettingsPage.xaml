<UserControl x:Class="OBS.Views.Pages.Settings.StudentSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:OBS.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
            <!-- Başlık -->
            <ui:SymbolIcon Symbol="PeopleEdit24" FontSize="48" 
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="Öğrenci Bilgileri Düzenleme" 
                       FontSize="20" FontWeight="SemiBold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,24">
                <TextBlock Text="Öğrencilerin fotoğraf, ad ve soyad bilgilerini buradan düzenleyebilirsiniz."
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled, Source={x:Static local:GlobalState.Instance}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Öğrencilerin ad, soyad, numara, TC, doğum tarihi ve sınıf bilgilerini buradan düzenleyebilirsiniz."
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled, Source={x:Static local:GlobalState.Instance}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Düzenleme Moduna Geç Butonu -->
            <ui:Button Appearance="Primary"
                       HorizontalAlignment="Stretch"
                       Padding="16,12"
                       Cursor="Hand"
                       Background="{DynamicResource SpecialButtonBgBrush}"
                       Command="{Binding EnterStudentEditModeCommand, Source={x:Static local:GlobalState.Instance}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SpecialButtonTextBrush}"/>
                    <TextBlock Text="Düzenleme Modu" 
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource SpecialButtonTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

            <!-- Bilgi Notu -->
            <Border Background="{DynamicResource BgBodyBrush}" 
                    CornerRadius="8" 
                    Padding="12,10"
                    Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" FontSize="16" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                     <Grid MaxWidth="220">
                         <TextBlock Text="Düzenleme modunda öğrencileri arayabilir, sınıfa göre filtreleyebilir ve fotoğraf, ad, soyad bilgilerini değiştirebilirsiniz."
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"
                                    TextWrapping="Wrap">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Setter Property="Visibility" Value="Visible"/>
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled, Source={x:Static local:GlobalState.Instance}}" Value="True">
                                             <Setter Property="Visibility" Value="Collapsed"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>

                         <TextBlock Text="Düzenleme modunda öğrencileri arayabilir, sınıfa göre filtreleyebilir ve bilgilerini değiştirebilirsiniz."
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"
                                    TextWrapping="Wrap">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Setter Property="Visibility" Value="Collapsed"/>
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled, Source={x:Static local:GlobalState.Instance}}" Value="True">
                                             <Setter Property="Visibility" Value="Visible"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                     </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
