<UserControl x:Class="OBS.Views.Pages.Settings.StudentSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:OBS.ViewModels"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
            <!-- Başlık -->
            <ui:SymbolIcon Symbol="PeopleEdit24" FontSize="48" 
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="Öğrenci Bilgileri Düzenleme" 
                       FontSize="20" FontWeight="SemiBold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Öğrencilerin ad, soyad, numara, TC, doğum tarihi ve sınıf bilgilerini buradan düzenleyebilirsiniz."
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Düzenleme Moduna Geç Butonu -->
            <ui:Button Appearance="Primary"
                       IsEnabled="False"
                       Opacity="0.5"
                       HorizontalAlignment="Stretch"
                       Padding="16,12"
                       Cursor="Arrow"
                       Background="{DynamicResource SpecialButtonBgBrush}"
                       Command="{Binding EnterStudentEditModeCommand, Source={x:Static local:GlobalState.Instance}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SpecialButtonTextBrush}"/>
                    <TextBlock Text="Düzenleme Modu (Devre Dışı)" 
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource SpecialButtonTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

            <!-- Yakında Eklenecek Notu -->
            <Border Background="#1aEAB308" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Clock24" FontSize="16" Foreground="#EAB308" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Yakında Eklenecektir" 
                               Foreground="#EAB308" 
                               FontSize="13" FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Bilgi Notu -->
            <Border Background="{DynamicResource BgBodyBrush}" 
                    CornerRadius="8" 
                    Padding="12,10"
                    Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" FontSize="16" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="Düzenleme modunda öğrencileri arayabilir, sınıfa göre filtreleyebilir ve bilgilerini değiştirebilirsiniz."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxWidth="220"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
