<UserControl x:Class="OBS.Views.Pages.Settings.DebugSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Debug"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,24"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource BgBodyBrush}"
                        CornerRadius="12"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Geliştirici Modu" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Debug seçeneklerini kullanabilmek için geliştirici modunu etkinleştirin. Etkinleştiğinde uygulama bu tercihi hatırlar."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Durum: "
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"/>
                            <TextBlock Text="Etkin"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       Visibility="{Binding IsDeveloperModeEnabled, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Kapalı"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeveloperModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Content="Geliştirici Modunu Etkinleştir"
                                       Appearance="Primary"
                                       Margin="0,0,12,12"
                                       Command="{Binding OpenDeveloperPinOverlayCommand}"
                                       CommandParameter="EnableDeveloperMode">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeveloperModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button Content="Geliştirici Modunu Kapat"
                                       Appearance="Secondary"
                                       Margin="0,0,0,12"
                                       Command="{Binding DisableDeveloperModeCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeveloperModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgBodyBrush}"
                        CornerRadius="12"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderColorBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ArrowEnterLeft24" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Login Ekranını Bypass Et"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Etkin olduğunda uygulama açılışta giriş ekranını atlayıp doğrudan ana ekrana gider."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Bu seçenek yalnızca geliştirici modu açıkken değiştirilebilir."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,12,12"
                                       Command="{Binding ToggleLoginBypassCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary"/>
                                        <Setter Property="Content" Value="Bypass'i Aç"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeveloperModeEnabled}" Value="True">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoginBypassEnabled}" Value="True">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="Content" Value="Bypass'i Kapat"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Text="Durum: "
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"/>
                                <TextBlock Text="Açık"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Visibility="{Binding IsLoginBypassEnabled, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Kapalı"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoginBypassEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgBodyBrush}"
                        CornerRadius="12"
                        Padding="20"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        Margin="0,24,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="PeopleEdit24" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Gelişmiş Düzenleme Modu"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Etkin olduğunda öğrenci düzenleme modu mevcut haliyle tüm alanları düzenleyebilir. Kapalıyken yalnızca fotoğraf, ad ve soyad değiştirilebilir."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Bu seçenek yalnızca geliştirici modu açıkken değiştirilebilir."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,16"/>

                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,12,12"
                                       Command="{Binding ToggleAdvancedStudentEditModeCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Secondary"/>
                                        <Setter Property="Content" Value="Gelişmiş Modu Aç"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeveloperModeEnabled}" Value="True">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled}" Value="True">
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Setter Property="Content" Value="Gelişmiş Modu Kapat"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Text="Durum: "
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"/>
                                <TextBlock Text="Açık"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Visibility="{Binding IsAdvancedStudentEditModeEnabled, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Kapalı"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdvancedStudentEditModeEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
