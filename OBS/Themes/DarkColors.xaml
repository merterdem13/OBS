<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme Colors (Siyah-Gri Tonları - Mavi/Lacivert Yok) -->
    <!-- Arkaplan -->
    <SolidColorBrush x:Key="BgBodyBrush" Color="#121212"/> <!-- Saf koyu gri/siyah (Material Design Dark Base) -->
    <SolidColorBrush x:Key="BgCardBrush" Color="#1e1e1e"/> <!-- Daha açık saf gri (Kartlar ve Modallar için) -->
    <!-- Metinler -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ffffff"/> <!-- Tam beyaz -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a0a0a0"/> <!-- Nötr gri -->
    <!-- Tasarım Elemanları -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#2d2d2d"/> <!-- İnce gri kenarlık -->
    <SolidColorBrush x:Key="AccentBrush" Color="#555555"/> <!-- Nötr Vurgu (Mavi yerine orta gri) -->

    <!-- Loading Overlay Fırçaları -->
    <SolidColorBrush x:Key="LoadingAccentBrush" Color="#3B82F6"/> <!-- Canlı Mavi -->
    <SolidColorBrush x:Key="LoadingProgressTextBrush" Color="#93C5FD"/> <!-- Açık Mavi Yüzde Yazısı -->
    <SolidColorBrush x:Key="LoadingBgBrush" Color="#e6121212"/> <!-- %90 Opaklıkta Koyu Gri -->

    <SolidColorBrush x:Key="HeaderBgBrush" Color="#e6121212"/> 
    <SolidColorBrush x:Key="ModalBgBrush" Color="#1e1e1e"/> <!-- Kartlarla aynı gri -->
    
    <!-- Özel Butonlar (Zıtlık için) -->
    <SolidColorBrush x:Key="NoteIndicatorBrush" Color="#3B82F6"/> <!-- Dark Mode Not Vurgusu (Canlı Mavi) -->
    <SolidColorBrush x:Key="SpecialButtonBgBrush" Color="#444444"/> <!-- Biraz daha koyu beyaz (Slate 200) -->
    <SolidColorBrush x:Key="SpecialButtonHoverBrush" Color="#5A5A5A"/> <!-- Hover için biraz daha açık gri -->
    <SolidColorBrush x:Key="SpecialButtonTextBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="TeamLogoBrush" Color="#ffffffff"/>

    <!-- Shared semantic resources -->
    <Color x:Key="SemanticOnColor">#F8FAFC</Color>
    <Color x:Key="SemanticDangerColor">#F43F5E</Color>
    <Color x:Key="SemanticDangerHoverColor">#E11D48</Color>
    <Color x:Key="SemanticDangerTextColor">#FB7185</Color>
    <Color x:Key="SemanticDangerActionColor">#EF4444</Color>
    <Color x:Key="SemanticDangerSurfaceColor">#1AFB7185</Color>
    <Color x:Key="SemanticWarningColor">#3B82F6</Color>
    <Color x:Key="SemanticModalBackdropColor">#B3000000</Color>
    <Color x:Key="SemanticModalBackdropAltColor">#C2000000</Color>
    <Color x:Key="SemanticModalBackdropBlockingColor">#D9000000</Color>
    <SolidColorBrush x:Key="SemanticOnColorBrush" Color="{StaticResource SemanticOnColor}"/>
    <SolidColorBrush x:Key="SemanticDangerBrush" Color="{StaticResource SemanticDangerColor}"/>
    <SolidColorBrush x:Key="SemanticDangerHoverBrush" Color="{StaticResource SemanticDangerHoverColor}"/>
    <SolidColorBrush x:Key="SemanticDangerTextBrush" Color="{StaticResource SemanticDangerTextColor}"/>
    <SolidColorBrush x:Key="SemanticDangerActionBrush" Color="{StaticResource SemanticDangerActionColor}"/>
    <SolidColorBrush x:Key="SemanticDangerSurfaceBrush" Color="{StaticResource SemanticDangerSurfaceColor}"/>
    <SolidColorBrush x:Key="SemanticWarningBrush" Color="{StaticResource SemanticWarningColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBrush" Color="{StaticResource SemanticModalBackdropColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropAltBrush" Color="{StaticResource SemanticModalBackdropAltColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBlockingBrush" Color="{StaticResource SemanticModalBackdropBlockingColor}"/>
    <Color x:Key="SemanticShadowColor">#000000</Color>
</ResourceDictionary>
