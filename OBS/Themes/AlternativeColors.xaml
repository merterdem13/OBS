<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Alternative Theme Colors (Deep Graphite & Amethyst) -->
    <!-- Arkaplan -->
    <SolidColorBrush x:Key="BgBodyBrush" Color="#212124"/> <!-- Deep Graphite Base -->
    <SolidColorBrush x:Key="BgCardBrush" Color="#2b2b2f"/> <!-- Graphite Card -->
    <!-- Metinler -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f0f0f0"/> <!-- Bright Off-white -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a1a1aa"/> <!-- Soft Gray Text -->
    <!-- Tasarım Elemanları -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#3a3a40"/> <!-- Graphite Border -->
    <SolidColorBrush x:Key="AccentBrush" Color="#c084fc"/> <!-- Amethyst Purple Accent -->
    
    <!-- Loading Overlay Fırçaları -->
    <SolidColorBrush x:Key="LoadingAccentBrush" Color="#c084fc"/> 
    <SolidColorBrush x:Key="LoadingProgressTextBrush" Color="#e9d5ff"/>
    <SolidColorBrush x:Key="LoadingBgBrush" Color="#e6212124"/>

    <SolidColorBrush x:Key="HeaderBgBrush" Color="#e6212124"/>
    <SolidColorBrush x:Key="ModalBgBrush" Color="#2b2b2f"/>
    <SolidColorBrush x:Key="TeamLogoBrush" Color="#ffffffff"/>
    
    <!-- Özel Butonlar ve Göstergeler (Koyu Temanın Eksik Kısımları) -->
    <SolidColorBrush x:Key="NoteIndicatorBrush" Color="#c084fc"/> <!-- Purple Note Highlight -->
    <SolidColorBrush x:Key="SpecialButtonBgBrush" Color="#3e3e46"/> <!-- Slate-Graphite Button -->
    <SolidColorBrush x:Key="SpecialButtonHoverBrush" Color="#52525b"/>
    <SolidColorBrush x:Key="SpecialButtonTextBrush" Color="#f8fafc"/>

    <!-- Shared semantic resources -->
    <Color x:Key="SemanticOnColor">#F8FAFC</Color>
    <Color x:Key="SemanticDangerColor">#FB7185</Color>
    <Color x:Key="SemanticDangerHoverColor">#F43F5E</Color>
    <Color x:Key="SemanticDangerTextColor">#FDA4AF</Color>
    <Color x:Key="SemanticDangerActionColor">#F43F5E</Color>
    <Color x:Key="SemanticDangerSurfaceColor">#1AFB7185</Color>
    <Color x:Key="SemanticWarningColor">#C084FC</Color>
    <Color x:Key="SemanticModalBackdropColor">#A6000000</Color>
    <Color x:Key="SemanticModalBackdropAltColor">#B8000000</Color>
    <Color x:Key="SemanticModalBackdropBlockingColor">#CF000000</Color>
    <SolidColorBrush x:Key="SemanticOnColorBrush" Color="{StaticResource SemanticOnColor}"/>
    <SolidColorBrush x:Key="SemanticDangerBrush" Color="{StaticResource SemanticDangerColor}"/>
    <SolidColorBrush x:Key="SemanticDangerHoverBrush" Color="{StaticResource SemanticDangerHoverColor}"/>
    <SolidColorBrush x:Key="SemanticDangerTextBrush" Color="{StaticResource SemanticDangerTextColor}"/>
    <SolidColorBrush x:Key="SemanticDangerActionBrush" Color="{StaticResource SemanticDangerActionColor}"/>
    <SolidColorBrush x:Key="SemanticDangerSurfaceBrush" Color="{StaticResource SemanticDangerSurfaceColor}"/>
    <SolidColorBrush x:Key="SemanticWarningBrush" Color="{StaticResource SemanticWarningColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBrush" Color="{StaticResource SemanticModalBackdropColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropAltBrush" Color="{StaticResource SemanticModalBackdropAltColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBlockingBrush" Color="{StaticResource SemanticModalBackdropBlockingColor}"/>
    <Color x:Key="SemanticShadowColor">#000000</Color>
</ResourceDictionary>
