<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme Colors (Modern & Premium Desert Sand Palette) -->
    <SolidColorBrush x:Key="BgBodyBrush" Color="#F5F5F4"/> <!-- Stone 50: Sıcak, doğal ve ferah arka plan -->
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/> <!-- Beyaz: Kartların arka plandan ayrılması için -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#44403C"/> <!-- Stone 800: Yumuşak ama okunaklı ana metin -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#78716C"/> <!-- Stone 600: Zarif ikincil metin -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#E7E5E4"/> <!-- Stone 200: Hafif ve doğal kenarlıklar -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D97706"/> <!-- Amber: Güçlü, asil ve modern vurgu rengi -->
    
    <!-- Loading Overlay Fırçaları -->
    <SolidColorBrush x:Key="LoadingAccentBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="LoadingProgressTextBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="LoadingBgBrush" Color="#F2FFFFFF"/> <!-- %95 Temiz Beyaz Arkaplan -->

    <SolidColorBrush x:Key="HeaderBgBrush" Color="#E7E5E4CC"/> <!-- Stone 200 with Opacity: Saydamlaştırılmış şık başlık -->
    <SolidColorBrush x:Key="ModalBgBrush" Color="#F5F5F4EE"/> <!-- Stone 50 with Opacity: Temiz modal arka planı -->

    <!-- Özel Butonlar (Desert Sand Style) -->
    <SolidColorBrush x:Key="NoteIndicatorBrush" Color="#D97706"/> <!-- Light Mode Not Vurgusu (Accent) -->
    <SolidColorBrush x:Key="SpecialButtonBgBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="SpecialButtonHoverBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SpecialButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TeamLogoBrush" Color="#44403C"/>

    <!-- Shared semantic resources -->
    <Color x:Key="SemanticOnColor">#FFFFFF</Color>
    <Color x:Key="SemanticDangerColor">#E11D48</Color>
    <Color x:Key="SemanticDangerHoverColor">#BE123C</Color>
    <Color x:Key="SemanticDangerTextColor">#EF4444</Color>
    <Color x:Key="SemanticDangerActionColor">#E53E3E</Color>
    <Color x:Key="SemanticDangerSurfaceColor">#15EF4444</Color>
    <Color x:Key="SemanticWarningColor">#D97706</Color>
    <Color x:Key="SemanticModalBackdropColor">#99000000</Color>
    <Color x:Key="SemanticModalBackdropAltColor">#AA000000</Color>
    <Color x:Key="SemanticModalBackdropBlockingColor">#CC000000</Color>
    <SolidColorBrush x:Key="SemanticOnColorBrush" Color="{StaticResource SemanticOnColor}"/>
    <SolidColorBrush x:Key="SemanticDangerBrush" Color="{StaticResource SemanticDangerColor}"/>
    <SolidColorBrush x:Key="SemanticDangerHoverBrush" Color="{StaticResource SemanticDangerHoverColor}"/>
    <SolidColorBrush x:Key="SemanticDangerTextBrush" Color="{StaticResource SemanticDangerTextColor}"/>
    <SolidColorBrush x:Key="SemanticDangerActionBrush" Color="{StaticResource SemanticDangerActionColor}"/>
    <SolidColorBrush x:Key="SemanticDangerSurfaceBrush" Color="{StaticResource SemanticDangerSurfaceColor}"/>
    <SolidColorBrush x:Key="SemanticWarningBrush" Color="{StaticResource SemanticWarningColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBrush" Color="{StaticResource SemanticModalBackdropColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropAltBrush" Color="{StaticResource SemanticModalBackdropAltColor}"/>
    <SolidColorBrush x:Key="SemanticModalBackdropBlockingBrush" Color="{StaticResource SemanticModalBackdropBlockingColor}"/>
    <Color x:Key="SemanticShadowColor">#000000</Color>
</ResourceDictionary>
